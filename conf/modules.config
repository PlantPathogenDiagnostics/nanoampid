/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            enabled: false
        ]
    }

    withName: CDHIT_CDHITEST {
        ext.args = '-c 1.0 -n 10 -d 0'
        publishDir = [
            enabled: false
        ]
    }

    withName: FILTLONG {
        ext.args = '--target_bases 750000'
        publishDir = [
            enabled: false
        ]
    }

    withName: BBMAP_REFORMAT {
        publishDir = [
            enabled: false
        ]
    }

    withName: SEQKIT_RMDUP {
        publishDir = [
            enabled: false
        ]
    }

    withName: PORECHOP_PORECHOP {
        ext.args = '--discard_middle'
        ext.prefix = { "${meta.id}_trimmed" }  
        publishDir = [
            enabled: false
        ]
    }

    withName: BBMAP_SEAL {
        ext.args = { "pattern=${meta.id}_%.fastq.gz" } 
        ext.args2 = 'ambig=all --ignorejunk qin=33'
        publishDir = [
            enabled: false
        ]
    }

    withName: SPOA {
        ext.args =  '-l 0 -r 0 -g -2'
        publishDir = [
            enabled: false
        ]
    }

    withName: ISONCLUST {
        ext.args =  '--mapped_threshold 1.0 --aligned_threshold 0.7  --k 10 --w 11 --rc_identity_threshold 1.0'
        publishDir = [
            enabled: false
        ]
    }

    withName: NANOQ_RAW {
        ext.prefix = { "${meta.id}_raw" } 
        publishDir = [
            enabled: false
        ]
    }

    withName: NANOQ_FILTERED {
        ext.prefix = { "${meta.id}_filtered" } 
        publishDir = [
            enabled: false
        ]
    }

    withName: VSEARCH_ORIENT {
        ext.prefix = { "${meta.id}" } 
        publishDir = [
            enabled: false
        ]
    }

    withName: CONCAT_FILES {
        ext.prefix = { "${meta.id}" } 
        publishDir = [
            enabled: false
        ]
    }

    withName: MINIMAP2_ALIGN {
        ext.args = '-x ava-ont'
        ext.prefix = { "${meta.id}_${meta.cluster}" }
        publishDir = [
            enabled: false
        ]
    }

    withName: RACON {
        ext.prefix = { "${meta.id}_${meta.cluster}" }
        publishDir = [
            enabled: false
        ]
    }

    withName: MEDAKA {
        ext.prefix = { "${meta.id}_${meta.cluster}" }
        publishDir = [
            enabled: false
        ]
    }

    withName: CHOPPER {
        ext.args2  = [
            params.min_quality ? "--quality ${params.min_quality}" : '',
            params.min_length ? "--minlength ${params.min_length}" : '',
            params.max_length ? "--maxlength ${params.max_length}" : '',
        ].join(' ').trim()
        ext.prefix = { "${meta.id}_chopper" }
        publishDir = [
            enabled: false
        ]
    }

    withName: BLAST_MAKEBLASTDB {
        ext.args = '-dbtype "nucl"'
        publishDir = [
            enabled: false
        ]
    }

    withName: BLAST_BLASTN{
        ext.args= [
            '-outfmt "6 qseqid pident slen qlen length qcovs mismatch gapopen evalue bitscore salltitles"',
            '-max_target_seqs 5',
            '-max_hsps 5',
            '-perc_identity 80'
        ].join(' ').trim()
        publishDir = [
            enabled: false
        ]
    }

    withName: BLASTNFILTER{
        ext.args= [
            params.min_ref_cov ? "--min_ref_cov ${params.min_ref_cov}" : '',
            params.min_pident ? "--min_pident ${params.min_pident}" : '',
            params.max_con_len ? "--max_con_len ${params.max_con_len}" : '',
            params.max_mismatch ? "--max_mismatch ${params.max_mismatch}" : '',
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/summary_output" }
        ]
    }


    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
